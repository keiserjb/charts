/**
 * Default colors used in all libraries.
 */
function charts_default_colors() {
  $form = config_get('charts.settings', 'charts_default_settings');

  if (isset($form['colors'])) {
    return $form['colors'];
  }
  else {
    return array(
      '#2f7ed8',
      '#0d233a',
      '#8bbc21',
      '#910000',
      '#1aadce',
      '#492970',
      '#f28f43',
      '#77a1e5',
      '#c42525',
      '#a6c96a',
    );
  }
}

/**
 * Recursive function to trim out empty options that aren't used.
 */
function charts_trim_array(&$array) {
  foreach ($array as $key => &$value) {
    if (is_array($value)) {
      charts_trim_array($value);
    }
    elseif (is_null($value) || (is_array($value) && count($value) === 0)) {
      unset($array[$key]);
    }
  }
}

/**
 * Recursive function to cast integer values.
 */
function charts_cast_element_integer_values(&$element) {
  // Cast options to integers to avoid redundant library fixing problems.
  $integer_options = array(
    // Chart options.
    '#title_font_size',
    '#font_size',
    '#legend_title_font_size',
    '#legend_font_size',
    '#width',
    '#height',
    // Axis options.
    '#title_font_size',
    '#labels_font_size',
    '#labels_rotation',
    '#max',
    '#min',
    // Data options.
    '#decimal_count',
  );
  foreach ($element as $property_name => $value) {
    if (is_array($element[$property_name])) {
      charts_cast_element_integer_values($element[$property_name]);
    }
    elseif ($property_name && in_array($property_name, $integer_options)) {
      $element[$property_name] = (is_null($element[$property_name]) || strlen($element[$property_name]) === 0) ? NULL : (int) $element[$property_name];
    }
  }
}

/**
 * Adds an accessible data table alternative to a chart element.
 */
function charts_accessible_table_element($element) {
  $visibility = isset($element['#accessible_table']) ? $element['#accessible_table'] : 'disabled';
  if ($visibility === 'disabled') {
    return $element;
  }

  $table = charts_accessible_table_build($element);
  if (empty($table['rows'])) {
    return $element;
  }

  $table_markup = theme('table', $table);
  if ($visibility === 'visible') {
    $element['#content_suffix']['accessible_table'] = '<div class="charts-accessible-table-wrapper">' . $table_markup . '</div>';
  }
  elseif ($visibility === 'invisible') {
    $element['#content_suffix']['accessible_table'] = '<div class="element-invisible charts-accessible-table-wrapper">' . $table_markup . '</div>';
  }
  elseif ($visibility === 'collapsible') {
    $summary = !empty($element['#accessible_table_button_text']) ? $element['#accessible_table_button_text'] : t('View data table');
    $class = !empty($element['#accessible_table_button_class']) ? ' class="' . check_plain($element['#accessible_table_button_class']) . '"' : '';
    $element['#content_suffix']['accessible_table'] = '<details class="charts-accessible-table-wrapper"><summary' . $class . '>' . check_plain($summary) . '</summary>' . $table_markup . '</details>';
  }

  return $element;
}

/**
 * Builds a table array from chart render data.
 */
function charts_accessible_table_build($element) {
  $chart_type = !empty($element['#chart_type']) ? $element['#chart_type'] : 'line';
  $type_info = chart_get_type($chart_type);
  $single_axis = !empty($type_info['axis']) && $type_info['axis'] === CHARTS_SINGLE_AXIS;

  $xaxis = array();
  $series = array();
  foreach (element_children($element) as $key) {
    if (empty($element[$key]['#type'])) {
      continue;
    }
    if ($element[$key]['#type'] === 'chart_xaxis') {
      $xaxis = $element[$key];
    }
    elseif ($element[$key]['#type'] === 'chart_data') {
      $series[] = array(
        'title' => !empty($element[$key]['#title']) ? $element[$key]['#title'] : t('Series @n', array('@n' => count($series) + 1)),
        'data' => !empty($element[$key]['#data']) ? $element[$key]['#data'] : array(),
        'labels' => !empty($element[$key]['#labels']) ? $element[$key]['#labels'] : array(),
      );
    }
  }

  $categories = !empty($xaxis['#labels']) ? array_values($xaxis['#labels']) : array();
  $table = array(
    'attributes' => array(
      'class' => array('charts-accessible-table'),
    ),
    'caption' => t('Data table for @title', array('@title' => !empty($element['#title']) ? $element['#title'] : t('Chart'))),
    'header' => array(),
    'rows' => array(),
    'sticky' => FALSE,
  );

  if ($single_axis) {
    $table['header'] = array(t('Label'), t('Value'));
    $first_series = reset($series);
    if (!$first_series) {
      return $table;
    }
    $labels = $first_series['labels'] ? array_values($first_series['labels']) : $categories;
    foreach ($first_series['data'] as $index => $point) {
      if (is_array($point)) {
        $label = isset($point[0]) ? $point[0] : (isset($labels[$index]) ? $labels[$index] : t('Slice @n', array('@n' => $index + 1)));
        $value = isset($point[1]) ? $point[1] : '';
      }
      else {
        $label = isset($labels[$index]) ? $labels[$index] : t('Slice @n', array('@n' => $index + 1));
        $value = $point;
      }
      $table['rows'][] = array($label, charts_accessible_table_data_point($value));
    }
    return $table;
  }

  $table['header'][] = !empty($xaxis['#title']) ? $xaxis['#title'] : t('Category');
  foreach ($series as $series_item) {
    $table['header'][] = $series_item['title'];
  }

  $max_rows = 0;
  foreach ($series as $series_item) {
    $max_rows = max($max_rows, count($series_item['data']));
  }

  for ($index = 0; $index < $max_rows; $index++) {
    $row = array(isset($categories[$index]) ? $categories[$index] : (string) ($index + 1));
    foreach ($series as $series_item) {
      $row[] = isset($series_item['data'][$index]) ? charts_accessible_table_data_point($series_item['data'][$index]) : '';
    }
    $table['rows'][] = $row;
  }

  return $table;
}

/**
 * Converts complex chart data points to readable table cell values.
 */
function charts_accessible_table_data_point($point) {
  if (is_scalar($point) || is_null($point)) {
    return $point;
  }
  if (!is_array($point)) {
    return '';
  }

  $parts = array();
  foreach ($point as $key => $value) {
    if (is_scalar($value)) {
      $parts[] = is_numeric($key) ? $value : ucfirst($key) . ': ' . $value;
    }
  }
  return implode(', ', $parts);
}


/**
 * Output the chart renderable as a string.
 */
function theme_charts_chart($variables) {
  $element = $variables['element'];

  $attributes = $element['#attributes'];
  if (!empty($attributes['class']) && is_array($attributes['class'])) {
    $attributes['class'] = array_values(array_unique($attributes['class']));
  }
  $attributes['id'] = $element['#id'];
  $attributes['class'][] = 'chart';

  $content_prefix = !empty($element['#content_prefix']) ? implode('', $element['#content_prefix']) : '';
  $content_suffix = !empty($element['#content_suffix']) ? implode('', $element['#content_suffix']) : '';
  $chart = isset($element['#chart']) ? $element['#chart'] : '';

  return $content_prefix . '<div ' . backdrop_attributes($attributes) . '>' . $chart . '</div>' . $content_suffix;
}

/**
 * Implements hook_autoload_info().
 */
function charts_autoload_info() {
  return array(
    'charts_plugin_display_chart' => 'views/charts_plugin_display_chart.inc',
    'charts_plugin_style_chart' => 'views/charts_plugin_style_chart.inc',
  );
}
